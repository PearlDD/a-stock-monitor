# PushPlus token for WeChat notifications (register at pushplus.plus)
PUSHPLUS_TOKEN=

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Redis URL for caching and dedup
REDIS_URL=redis://localhost:6379/0

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///data/stock_monitor.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone — server is in US, all scheduling/display uses Asia/Shanghai
TIMEZONE=Asia/Shanghai
