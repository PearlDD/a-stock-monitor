# Data mode: 'mock' for demo data (no AKShare needed), 'live' for real data
# Use 'mock' when developing outside China where AKShare cannot connect
DATA_MODE=mock

# PushPlus token for WeChat notifications (register at pushplus.plus)
PUSHPLUS_TOKEN=

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# Claude / Anthropic API key (https://console.anthropic.com)
CLAUDE_API_KEY=

# AI provider routing — which provider to use for each task
# Options: claude, deepseek, openai, qwen
AI_PROVIDER_ANALYSIS=claude
AI_PROVIDER_SCREENING=deepseek

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///data/stock_monitor.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone — server is in US, all scheduling/display uses Asia/Shanghai
TIMEZONE=Asia/Shanghai
