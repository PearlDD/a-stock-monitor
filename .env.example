# Supabase (get from supabase.com dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public browser configuration. These are safe to expose, unlike the service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Required before enabling per-user PushPlus tokens. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Optional: only this deployed web origin gets CORS response headers.
ALLOWED_ORIGIN=https://your-site.netlify.app

# Timezone
TIMEZONE=Asia/Shanghai
