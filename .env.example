# Data mode: 'mock' for demo data (no AKShare needed), 'live' for real data
# Use 'mock' when developing outside China where AKShare cannot connect
DATA_MODE=mock

# PushPlus token for WeChat notifications (register at pushplus.plus)
PUSHPLUS_TOKEN=

# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///data/stock_monitor.db

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Timezone — server is in US, all scheduling/display uses Asia/Shanghai
TIMEZONE=Asia/Shanghai
